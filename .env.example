PORT=5000
DATABASE_URL="mysql://user:password@localhost:3306/adplaylist?allowPublicKeyRetrieval=true"
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000,http://nl.localhost:3000

# File storage: "supabase" (development, the default) or "s3" (production)
STORAGE_DRIVER=supabase

# Used when STORAGE_DRIVER=s3
AWS_REGION=eu-north-1
S3_BUCKET=adplaylist-prod-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional; defaults to https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_BASE_URL=

# Used when STORAGE_DRIVER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=change-me
SUPABASE_STORAGE_BUCKET=uploads

# From Google Cloud Console > APIs & Services > Credentials (OAuth client ID, Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me

# Outgoing mail (Namecheap Private Email): admin replies to contact enquiries
SMTP_HOST="mail.privateemail.com"
SMTP_PORT="465"
SMTP_USER="info@adplaylist.com"
SMTP_PASS=""
MAIL_FROM="Adplaylist <info@adplaylist.com>"
CONTACT_NOTIFY_TO="info@adplaylist.com"
