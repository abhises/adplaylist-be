generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Ad {
  id                  Int      @id @default(autoincrement())
  slug                String   @unique(map: "slug") @db.VarChar(150)
  title               String   @db.VarChar(255)
  format              String   @db.VarChar(100)
  variant             String   @db.VarChar(20)
  eyebrow             String?  @db.VarChar(100)
  headline            String   @db.VarChar(255)
  sub                 String?  @db.VarChar(255)
  cta                 String?  @db.VarChar(100)
  badge               String?  @db.VarChar(100)
  description         String?  @db.Text
  brandName           String?  @map("brand_name") @db.VarChar(255)
  primaryText         String?  @map("primary_text") @db.Text
  creativeDescription String?  @map("creative_description") @db.Text
  tags                String?  @db.Text
  mediaType           String   @map("media_type") @db.VarChar(10)
  swatch              String   @db.VarChar(255)
  light               Boolean  @default(false)
  category            String   @db.VarChar(100)
  // Every category the ad is in (JSON array). `category` is the first one,
  // kept for breadcrumbs and page titles. Null on ads saved before this.
  categories          Json?
  market              String   @db.VarChar(50)
  language            String   @default("English (EN)") @db.VarChar(50)
  photoUrl            String?  @map("photo_url") @db.VarChar(500)
  // A copy of photoUrl with the ADPLAYLIST watermark baked in: what unpaid
  // users get from Download (pages and paid downloads use the clean
  // photoUrl). Made on first need; null until then or after a new upload.
  watermarkedPhotoUrl String?  @map("watermarked_photo_url") @db.VarChar(500)
  platforms           String   @db.VarChar(255)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  editable            Boolean  @default(false)
  dominantColor       String?  @map("dominant_color") @db.VarChar(30)
  videoLength         String?  @map("video_length") @db.VarChar(20)
  canvaUrl            String?  @map("canva_url") @db.VarChar(500)
  // Picked by an admin to show on the landing page: `featured` in the
  // library section; `heroPlatforms` lists the hero panel tabs it was picked
  // for (comma-separated, e.g. "META,Google"; empty when not in the hero).
  featured            Boolean  @default(false)
  heroPlatforms       String   @default("") @map("hero_platforms") @db.VarChar(100)

  // SEO page fields, filled from the ad's CSV (see the "Adplaylist File"
  // template). All optional: older ads fall back to generated values.
  subcategory     String?   @db.VarChar(100)
  // The creative style (Testimonial, UGC…). Not `format`, which holds the
  // placement size.
  adFormat        String?   @map("ad_format") @db.VarChar(50)
  onImageText     String?   @map("on_image_text") @db.Text
  seoTitle        String?   @map("seo_title") @db.VarChar(255)
  metaDescription String?   @map("meta_description") @db.VarChar(500)
  pageHeadline    String?   @map("page_headline") @db.VarChar(255)
  introParagraph  String?   @map("intro_paragraph") @db.Text
  imageFileName   String?   @map("image_file_name") @db.VarChar(255)
  imageAlt        String?   @map("image_alt") @db.VarChar(255)
  imageCaption    String?   @map("image_caption") @db.VarChar(500)
  // The long-form editorial sections (takeaways, why it works, breakdown,
  // headline ideas, linking lists). Shape: AdContent in lib/adContent.ts.
  content         Json?
  authorId        Int?      @map("author_id")
  reviewerId      Int?      @map("reviewer_id")
  author          Author?   @relation("AdAuthor", fields: [authorId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_ads_author")
  reviewer        Author?   @relation("AdReviewer", fields: [reviewerId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_ads_reviewer")
  // Shown on the page as "Added" / "Updated". dateAdded falls back to
  // createdAt for ads published before these existed.
  dateAdded       DateTime? @map("date_added") @db.Date
  dateUpdated     DateTime? @map("date_updated") @db.Date

  creativeRequests CreativeRequest[]
  savedAds         SavedAd[]
  oldSlugs         AdSlugRedirect[]

  @@index([authorId], map: "fk_ads_author")
  @@index([reviewerId], map: "fk_ads_reviewer")
  @@map("ads")
}

// A slug an ad used to have, so links to it keep working after the slug is
// changed (the ad page redirects permanently to the current slug).
model AdSlugRedirect {
  id        Int      @id @default(autoincrement())
  oldSlug   String   @unique(map: "ad_slug_redirects_old_slug") @map("old_slug") @db.VarChar(150)
  adId      Int      @map("ad_id")
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ad_slug_redirects_ad")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([adId], map: "fk_ad_slug_redirects_ad")
  @@map("ad_slug_redirects")
}

// A curator credited on ad pages ("Added by" / "Reviewed by"), with a public
// profile at /authors/<slug>. Separate from users: an author doesn't need a
// login, and a staff member's account details stay private.
model Author {
  id          Int      @id @default(autoincrement())
  slug        String   @unique(map: "authors_slug") @db.VarChar(150)
  name        String   @db.VarChar(255)
  jobTitle    String?  @map("job_title") @db.VarChar(255)
  // Short credentials line, e.g. "9 years in DTC paid social".
  credentials String?  @db.VarChar(255)
  bio         String?  @db.Text
  photoUrl    String?  @map("photo_url") @db.VarChar(500)
  linkedinUrl String?  @map("linkedin_url") @db.VarChar(500)
  websiteUrl  String?  @map("website_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  adsAdded    Ad[]     @relation("AdAuthor")
  adsReviewed Ad[]     @relation("AdReviewer")

  @@map("authors")
}

model CreativeRequest {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  title          String    @db.VarChar(255)
  type           String    @default("New creative") @db.VarChar(50)
  sizeNeeded     String?   @map("size_needed") @db.VarChar(150)
  neededBy       DateTime? @map("needed_by") @db.Date
  notes          String?   @db.Text
  status         String    @default("Open") @db.VarChar(30)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  reason         String?   @db.Text
  adId           Int?      @map("ad_id")
  // Link to the ad the request is about (an Adplaylist ad page or any URL).
  adUrl          String?   @map("ad_url") @db.VarChar(1000)
  // Set on delivery: the link to the finished creative, and a message for
  // the client.
  deliveredUrl   String?   @map("delivered_url") @db.VarChar(1000)
  deliveryNote   String?   @map("delivery_note") @db.Text
  attachmentUrl  String?   @map("attachment_url") @db.VarChar(500)
  attachmentName String?   @map("attachment_name") @db.VarChar(255)
  // The account whose credit paid for this request (null for staff, or for
  // requests made before credits existed). Declining refunds it.
  accountId      Int?      @map("account_id")
  creditCharged  Boolean   @default(false) @map("credit_charged")
  account        Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_requests_account")
  ad             Ad?       @relation(fields: [adId], references: [id], onUpdate: NoAction, map: "fk_requests_ad")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_requests_user")
  notifications  Notification[]

  @@index([adId], map: "fk_requests_ad")
  @@index([userId], map: "fk_requests_user")
  @@index([accountId], map: "fk_requests_account")
  @@map("creative_requests")
}

model SavedAd {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  adId      Int      @map("ad_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_saved_ads_ad")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_saved_ads_user")

  @@unique([userId, adId], map: "uniq_user_ad")
  @@index([adId], map: "fk_saved_ads_ad")
  @@map("saved_ads")
}

model User {
  id                  Int               @id @default(autoincrement())
  email               String            @unique(map: "email") @db.VarChar(255)
  passwordHash        String?           @map("password_hash") @db.VarChar(255)
  googleId            String?           @unique(map: "google_id") @map("google_id") @db.VarChar(255)
  fullName            String            @map("full_name") @db.VarChar(255)
  defaultLanguage     String            @default("English (EN)") @map("default_language") @db.VarChar(50)
  gridDensity         String            @default("Comfortable") @map("grid_density") @db.VarChar(20)
  prefOnboarding      Boolean           @default(true) @map("pref_onboarding")
  prefProduct         Boolean           @default(true) @map("pref_product")
  prefPromotions      Boolean           @default(false) @map("pref_promotions")
  prefBrand           Boolean           @default(true) @map("pref_brand")
  prefNewsletter      Boolean           @default(false) @map("pref_newsletter")
  role                String            @default("client") @db.VarChar(20)
  // Extra access on top of the role, granted by an admin: managing the blog
  // and/or brand pages. Admins can always do both.
  canManageBlog       Boolean           @default(false) @map("can_manage_blog")
  canManageBrandPages Boolean           @default(false) @map("can_manage_brand_pages")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  // The customer account (company) this person belongs to, and whether they
  // own it or were invited. Null for Adplaylist staff, who never use a seat.
  accountId           Int?              @map("account_id")
  accountRole         String?           @map("account_role") @db.VarChar(10)
  account             Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_users_account")
  creativeRequests    CreativeRequest[]
  savedAds            SavedAd[]
  feedback            Feedback[]
  contactReplies      ContactReply[]
  notifications       Notification[]     @relation("NotificationActor")
  notificationsToMe   Notification[]     @relation("NotificationRecipient")
  notificationReads   NotificationRead[]
  onboardingAnswers   OnboardingAnswers?

  @@index([accountId], map: "fk_users_account")
  @@map("users")
}

// A client's answers to the "Tell us about your brand" questionnaire that
// pops up in the library, and is editable later from the profile page. One
// row per user, saved step by step, so a half-finished one is kept too.
model OnboardingAnswers {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique(map: "onboarding_answers_user") @map("user_id")
  niche       String?   @db.VarChar(255)
  product     String?   @db.Text
  brand       String?   @db.VarChar(255)
  website     String?   @db.VarChar(500)
  // "meta" (Meta Ad Library) or "google" (Google Ads Transparency).
  libraryType String?   @map("library_type") @db.VarChar(10)
  libraryUrl  String?   @map("library_url") @db.VarChar(1000)
  // Up to 5 brand names or websites.
  competitors Json?
  completedAt DateTime? @map("completed_at") @db.Timestamp(0)
  // Last "Skip for now", so the popup waits a while before asking again.
  skippedAt   DateTime? @map("skipped_at") @db.Timestamp(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_onboarding_answers_user")

  @@map("onboarding_answers")
}

// Admin-written landing pages for outreach, e.g. /brands/samsung. The body
// is admin-authored HTML, sanitized on write before it's stored.
model BrandPage {
  id        Int      @id @default(autoincrement())
  slug      String   @unique(map: "brand_pages_slug") @db.VarChar(150)
  brandName String   @map("brand_name") @db.VarChar(150)
  heading   String   @db.VarChar(255)
  bodyHtml  String   @map("body_html") @db.LongText
  ctaLabel  String   @default("Sign up") @map("cta_label") @db.VarChar(100)
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("brand_pages")
}

// The list of tags designers pick from. Ads store their tags as a
// comma-separated string (ads.tags), so tag names can't contain commas.
model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique(map: "tag_name") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("tags")
}

model BlogPost {
  id            Int       @id @default(autoincrement())
  slug          String    @unique(map: "blog_posts_slug") @db.VarChar(150)
  title         String    @db.VarChar(255)
  excerpt       String?   @db.VarChar(500)
  coverImageUrl String?   @map("cover_image_url") @db.VarChar(500)
  bodyHtml      String    @map("body_html") @db.LongText
  published     Boolean   @default(false)
  // Set the first time the post is published, and kept if it's unpublished
  // and republished, so the date shown on the blog doesn't jump around.
  publishedAt   DateTime? @map("published_at") @db.Timestamp(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("blog_posts")
}

// Sent from the Feedback tab on the library pages, read by admins in
// /admin/feedback.
model Feedback {
  id             Int      @id @default(autoincrement())
  userId         Int?     @map("user_id")
  message        String   @db.Text
  // Where to reply, if the sender wants one — may differ from their login.
  email          String?  @db.VarChar(255)
  screenshotUrl  String?  @map("screenshot_url") @db.VarChar(500)
  screenshotName String?  @map("screenshot_name") @db.VarChar(255)
  pageUrl        String?  @map("page_url") @db.VarChar(500)
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_feedback_user")

  @@index([userId], map: "fk_feedback_user")
  @@map("feedback")
}

// A paying customer (company). Plan, status and credits live here rather than
// on the user, so every seat shares them. Stripe is the source of truth for
// the subscription; webhooks (routes/billing.ts) copy its state into these
// columns. See "Adplaylist – User Types & Plan Rules" for the rules.
model Account {
  id                   Int                 @id @default(autoincrement())
  name                 String              @db.VarChar(255)
  // starter | pro | agency
  plan                 String              @default("starter") @db.VarChar(20)
  // Credits per month the plan includes: 0 for Starter, 10–40 Pro, 50–150 Agency.
  creditVolume         Int                 @default(0) @map("credit_volume")
  // monthly | yearly
  billingCycle         String              @default("monthly") @map("billing_cycle") @db.VarChar(10)
  // trial | active | past_due | cancelled | expired
  status               String              @default("trial") @db.VarChar(20)
  trialEndsAt          DateTime?           @map("trial_ends_at") @db.DateTime(0)
  // When the paid period ends; for a cancelled account, when it expires.
  currentPeriodEnd     DateTime?           @map("current_period_end") @db.DateTime(0)
  pastDueSince         DateTime?           @map("past_due_since") @db.DateTime(0)
  credits              Int                 @default(0)
  // Yearly plans refill monthly; this is when the next refill is due.
  nextRefillAt         DateTime?           @map("next_refill_at") @db.DateTime(0)
  // The paid invoice that last refilled credits, so handling it twice (a
  // redelivered webhook, or the checkout return page) can't refill again.
  lastRefillInvoiceId  String?             @map("last_refill_invoice_id") @db.VarChar(255)
  stripeCustomerId     String?             @unique(map: "accounts_stripe_customer") @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId String?             @unique(map: "accounts_stripe_subscription") @map("stripe_subscription_id") @db.VarChar(255)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  users                User[]
  creativeRequests     CreativeRequest[]
  creditTransactions   CreditTransaction[]

  @@map("accounts")
}

// Every change to an account's credits, so customers can see where their
// credits came from and went, and lifetime totals add up. `balance` is the
// account's credits right after this entry.
model CreditTransaction {
  id              Int      @id @default(autoincrement())
  accountId       Int      @map("account_id")
  // trial | refill | upgrade | spent | refunded | expired | adjustment
  reason          String   @db.VarChar(20)
  delta           Int
  balance         Int
  note            String?  @db.VarChar(255)
  requestId       Int?     @map("request_id")
  // The Stripe invoice that paid for a grant (trial start, refill, upgrade),
  // so each payment can show the credits it bought.
  stripeInvoiceId String?  @map("stripe_invoice_id") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_credit_tx_account")

  @@index([accountId, createdAt], map: "credit_tx_account_created")
  @@index([stripeInvoiceId], map: "credit_tx_invoice")
  @@map("credit_transactions")
}

// Stripe webhook event ids already handled, so a redelivered event can't
// refill credits twice.
model StripeEvent {
  id        String   @id @db.VarChar(255)
  type      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("stripe_events")
}

// The price of each plan + credit volume, editable by admins. Seeded with
// the defaults in lib/plans.ts. Changing one creates new Stripe prices
// (lib/catalog.ts); existing subscribers keep the price they signed up at.
model PlanPrice {
  plan         String   @db.VarChar(20)
  volume       Int
  monthlyCents Int      @map("monthly_cents")
  yearlyCents  Int      @map("yearly_cents")
  // Credits a month this tier gives. Starts equal to `volume`, which stays
  // the tier's fixed id (Stripe product, accounts' creditVolume); admins can
  // change the credits without moving anyone to another tier.
  credits      Int
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  updatedById  Int?     @map("updated_by_id")

  @@id([plan, volume])
  @@map("plan_prices")
}

// Every price a plan + credit volume has had: a row per change, so admins can
// see what it cost and from when to when. A price is in effect from its
// changedAt until the next row for the same plan + volume.
model PlanPriceChange {
  id              Int      @id @default(autoincrement())
  plan            String   @db.VarChar(20)
  volume          Int
  // Null on each plan's starting price, recorded when history began.
  oldMonthlyCents Int?     @map("old_monthly_cents")
  oldYearlyCents  Int?     @map("old_yearly_cents")
  monthlyCents    Int      @map("monthly_cents")
  yearlyCents     Int      @map("yearly_cents")
  oldCredits      Int?     @map("old_credits")
  credits         Int
  changedById     Int?     @map("changed_by_id")
  changedAt       DateTime @default(now()) @map("changed_at") @db.Timestamp(0)

  @@index([plan, volume, changedAt])
  @@map("plan_price_changes")
}

// An enquiry from the landing page's "Talk to us" form (custom volume,
// custom price). Admins answer it from Admin → Contact; each answer is
// emailed to the sender from info@adplaylist.com and kept as a reply.
model ContactEnquiry {
  id        Int            @id @default(autoincrement())
  name      String         @db.VarChar(255)
  email     String         @db.VarChar(255)
  company   String?        @db.VarChar(255)
  // Custom ads per month they asked about, e.g. "250–500".
  volume    String?        @db.VarChar(50)
  message   String         @db.Text
  // new → replied (after the first reply) → closed (by an admin).
  status    String         @default("new") @db.VarChar(20)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  replies   ContactReply[]

  @@index([status], map: "contact_enquiries_status")
  @@map("contact_enquiries")
}

model ContactReply {
  id        Int            @id @default(autoincrement())
  enquiryId Int            @map("enquiry_id")
  subject   String         @db.VarChar(255)
  body      String         @db.Text
  // The admin who sent it; kept if they're later removed.
  sentById  Int?           @map("sent_by_id")
  sentAt    DateTime       @default(now()) @map("sent_at") @db.Timestamp(0)
  enquiry   ContactEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_contact_replies_enquiry")
  sentBy    User?          @relation(fields: [sentById], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_contact_replies_user")

  @@index([enquiryId], map: "fk_contact_replies_enquiry")
  @@index([sentById], map: "fk_contact_replies_user")
  @@map("contact_replies")
}

// Everyone's notifications, shown under the bell. Each one goes to an
// audience: "staff" (designers and admins), "admin" (admins only), or "user"
// (just recipientId, e.g. a customer whose request was delivered). Each
// person has their own read status (NotificationRead). New rows are also
// pushed live over Socket.IO.
model Notification {
  id          Int                @id @default(autoincrement())
  // staff | admin | user
  audience    String             @db.VarChar(10)
  recipientId Int?               @map("recipient_id")
  // request.created | request.delivered | request.declined | contact.created
  // | feedback.created | user.signup | payment.received
  type        String             @db.VarChar(40)
  title       String             @db.VarChar(255)
  body        String?            @db.Text
  // The page it opens, e.g. /admin/requests?request=12.
  link        String?            @db.VarChar(500)
  requestId   Int?               @map("request_id")
  // Who caused it, e.g. the customer who sent the request.
  actorId     Int?               @map("actor_id")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamp(0)
  request     CreativeRequest?   @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notifications_request")
  actor       User?              @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_notifications_actor")
  recipient   User?              @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notifications_recipient")
  reads       NotificationRead[]

  @@index([audience, createdAt], map: "notifications_audience_created")
  @@index([recipientId], map: "fk_notifications_recipient")
  @@index([requestId], map: "fk_notifications_request")
  @@index([actorId], map: "fk_notifications_actor")
  @@map("notifications")
}

// Who has read which notification. No row means unread for that person.
model NotificationRead {
  notificationId Int          @map("notification_id")
  userId         Int          @map("user_id")
  readAt         DateTime     @default(now()) @map("read_at") @db.Timestamp(0)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notification_reads_notification")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notification_reads_user")

  @@id([notificationId, userId])
  @@index([userId], map: "fk_notification_reads_user")
  @@map("notification_reads")
}
